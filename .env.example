# Copy this file to ".env" (same folder) and fill in the values after the "=".
# .env is git-ignored, so keys never get committed. Never paste real keys into THIS file.

# Claude API (voice brain) — https://platform.claude.com → API keys
ANTHROPIC_API_KEY=

# Supabase (online database) — Project Settings → API
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Telegram alerts — make a bot with @BotFather; get the chat id with:
#   python -m basestation.alerts.telegram --find-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
