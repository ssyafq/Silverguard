# .env.example (server): settings for running main.py on your own PC.
# On Cloud Run these come from deploy.ps1 / Secret Manager instead, so this is only for local runs.
# PowerShell does not read .env files by itself: set them per session, e.g.
#   $env:STORE="memory"; $env:DEVICE_KEYS="watch-01=dev"; uvicorn main:app --port 8080

# memory = nothing saved, no Google account needed. firestore = the real database.
STORE=memory
# device_id=key pairs, comma separated. Use a long random key for anything but local tests.
DEVICE_KEYS=watch-01=dev
# Only needed with STORE=firestore on your PC (after `gcloud auth application-default login`)
GOOGLE_CLOUD_PROJECT=
