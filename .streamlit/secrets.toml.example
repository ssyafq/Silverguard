# Copy to .streamlit/secrets.toml for local use (git-ignored).
# Online: paste the same lines into the Streamlit Cloud app → Settings → Secrets.
# Leave the Supabase lines empty to use the built-in sample data.

SUPABASE_URL = ""
SUPABASE_SECRET_KEY = ""
dashboard_password = ""     # empty = no password (only OK on your own laptop)
elder_phone = ""            # e.g. "+6591234567" — enables the "Call" button
